generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

// Better Auth models
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

enum UmkmStatus {
  PENDING
  APPROVED
  REJECTED
}

// UMKM models
model Umkm {
  id              String       @id @default(cuid())
  namaUsaha       String       @map("nama_usaha")
  deskripsi       String
  alamat          String
  namaPemilik     String       @map("nama_pemilik")
  whatsapp        String
  tanggalMulai    DateTime     @map("tanggal_mulai")
  alamatPribadi   String       @map("alamat_pribadi")
  thumbnailIndex  Int          @default(0) @map("thumbnail_index")
  showPhotoAlert  Boolean      @default(false) @map("show_photo_alert")
  isActive        Boolean      @default(true) @map("is_active")
  status          UmkmStatus   @default(APPROVED) @map("status")
  approvedAt      DateTime?    @map("approved_at")
  rejectedAt      DateTime?    @map("rejected_at")
  rejectionReason String?      @map("rejection_reason")
  categoryId      String?      @map("category_id")
  category        Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  socialLinks     SocialLink[]
  images          UmkmImage[]

  @@index([categoryId])
  @@index([status])
  @@index([isActive])
  @@index([isActive, status])
  @@map("umkm")
}

model SocialLink {
  id       String @id @default(cuid())
  umkmId   String @map("umkm_id")
  platform String
  url      String
  umkm     Umkm   @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@index([umkmId])
  @@map("social_links")
}

model UmkmImage {
  id        String   @id @default(cuid())
  umkmId    String   @map("umkm_id")
  publicId  String   @map("public_id")
  url       String
  urutan    Int
  createdAt DateTime @default(now()) @map("created_at")
  umkm      Umkm     @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@index([umkmId])
  @@map("umkm_images")
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  author    String
  role      String?
  avatar    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("testimonials")
}

model HeroBanner {
  id          String    @id @default(cuid())
  title       String?
  subtitle    String?
  link        String?
  image       String
  mobileImage String?   @map("mobile_image")
  active      Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("hero_banners")
}

// Category model
model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  order     Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  umkms     Umkm[]

  @@map("categories")
}

model AboutContent {
  id         String   @id @default(cuid())
  title      String
  paragraph1 String
  paragraph2 String
  ctaText    String   @default("Jelajahi UMKM")
  ctaLink    String   @default("#umkm")
  active     Boolean  @default(true)
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("about_content")
}

model MetricsContent {
  id           String   @id @default(cuid())
  sectionTitle String
  label1       String
  label2       String
  label3       String
  label4       String
  active       Boolean  @default(true)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("metrics_content")
}

model RateLimit {
  id        String   @id @default(cuid())
  identifier String  @unique
  count     Int
  expiresAt DateTime @map("expires_at")

  @@map("rate_limits")
}

// Audit log for admin actions
model AdminLog {
  id         String   @id @default(cuid())
  adminId    String   @map("admin_id")
  adminEmail String   @map("admin_email")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  detail     Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([adminId])
  @@index([entityType, entityId])
  @@map("admin_logs")
}
